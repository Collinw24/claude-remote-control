# === REQUIRED ===
# Shared secret token — the mobile app must send this to connect.
# Generate a long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REMOTE_TOKEN=change-this-to-a-long-random-token

# Path to the project directory Claude Code should work in
PROJECT_DIR=/absolute/path/to/your/project

# DeepSeek API key (used by the server to set ANTHROPIC_AUTH_TOKEN for Claude Code)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# === OPTIONAL ===
# Server port (default: 3001)
PORT=3001

# Allow destructive git commands without confirmation (default: false)
# WARNING: Setting this to true skips confirmation for git reset --hard,
# git clean -fdx, and reverts. Use only in safe environments.
ALLOW_DESTRUCTIVE_ACTIONS=false

# Path to the claude binary (auto-detected if not set)
# CLAUDE_PATH=/usr/local/bin/claude

# DeepSeek model to use (default: deepseek-v4-pro)
# ANTHROPIC_MODEL=deepseek-v4-pro

# Log level: error, warn, info, debug (default: info)
LOG_LEVEL=info
